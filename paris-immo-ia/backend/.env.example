DATABASE_URL=postgresql://immo:immo@localhost:5432/immo
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# LLM : auto | anthropic | openai | heuristic (sans clé = extracteur à règles)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Whisper (bouton micro) : nécessite OPENAI_API_KEY, sinon dictée du navigateur
WHISPER_MODEL=whisper-1

# Temps de trajet réels en transports (sinon estimation locale)
GOOGLE_MAPS_API_KEY=

# Matching
PERFECT_MATCH_SCORE=75
TOP_K=3

# Alertes : 0 = lancer le worker séparément (python -m app.workers.alerts --loop 300)
ALERTS_INTERVAL_SECONDS=0
ALERT_MIN_SCORE=90
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@paris-immo-ia.local
